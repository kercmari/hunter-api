
NODE_ENV=development
# 3000 es el puerto al que apunta el túnel ngrok.
PORT=3000

# --- PostgreSQL ------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=hunter
DB_PASSWORD=
DB_NAME=hunter

# TLS contra la base de datos. Obligatorio en produccion, salvo que la base
# solo sea alcanzable por una red privada (ver DB_TRUSTED_NETWORK).
DB_SSL=false
# Declara que la base vive en una red privada y no necesita TLS.
# docker-compose lo activa solo para su red interna. En una base gestionada
DB_TRUSTED_NETWORK=false
# Bajar solo en entornos con certificado autofirmado.
DB_SSL_REJECT_UNAUTHORIZED=true


DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# --- Seguridad -------------------------------------------------------
API_KEY=

# Origenes permitidos por CORS, separados por coma. Vacio = CORS deshabilitado.
CORS_ORIGINS=

# Limite de peticiones por IP dentro de la ventana.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120


# --- HubSpot ---------------------------------------------------------
# Token de la app privada. Requiere el scope conversations.read.
HUBSPOT_TOKEN=
# Client secret de la app privada: valida la firma de los webhooks.
HUBSPOT_CLIENT_SECRET=
# Identificador del portal: descarta eventos de otros portales.
HUBSPOT_PORTAL_ID=

# Credencial de las ocho tools de ElevenLabs (fallback: API_KEY)
CONVAI_API_KEY=
PUBLIC_BASE_URL=https://your-domain.ngrok-free.dev
LINK_SIGNING_SECRET=
# Solo para pruebas: nunca realiza un cobro real.
ENABLE_DEMO_CHECKOUT=false
